[Unit]
Description=Anthropic API proxy with per-session quota and audit (optional)
Documentation=https://github.com/mikelm20/microvm-terminal/tree/main/proxy
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=microvm
Group=microvm
# ANTHROPIC_API_KEYS, POSTGRES_URL, PROXY_ADMIN_TOKEN, PROXY_TLS_CERT_FILE and
# PROXY_TLS_KEY_FILE come from this file (mode 0600, owner root:microvm 0640).
EnvironmentFile=/etc/microvm-terminal/proxy.env
ExecStart=/usr/local/bin/claude-proxy \
  --listen :8443 \
  --upstream https://api.anthropic.com
Environment=HOME=/var/lib/microvm-terminal
Restart=always
RestartSec=2s
StartLimitBurst=20
StartLimitIntervalSec=60

# Lockdown.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Listens on :8443. VMs reach it at the bridge address (172.20.0.1); ufw and
# nftables keep it off the public interface.

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
