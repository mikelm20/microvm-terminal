[Unit]
Description=Load learn-platform nftables egress allowlist
Documentation=https://github.com/mikelm20/learn-platform/blob/main/infra/nftables/learn.rules
# We must be loaded before the control plane starts any VM, otherwise the
# first few seconds of a VM life have unrestricted egress.
Before=learn-control-plane.service
After=network-pre.target
Wants=network-pre.target
DefaultDependencies=no

[Service]
Type=oneshot
# Load the rules then fill the dynamic sets. Both are idempotent; re-runs are
# a no-op if nothing changed.
ExecStart=/usr/sbin/nft -f /etc/learn-platform/nftables/learn.rules
ExecStartPost=/usr/local/libexec/learn-platform/refresh-sets.sh
RemainAfterExit=yes

# On stop we remove the whole table so the host goes back to a clean slate.
ExecStop=/usr/sbin/nft delete table inet learn

[Install]
WantedBy=multi-user.target
