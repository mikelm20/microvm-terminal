[Unit]
Description=Jailed Firecracker microVM for learn-platform session %i
Documentation=https://github.com/mikelm20/learn-platform/blob/main/infra/jailer/README.md
After=network-online.target learn-nftables.service
Requires=learn-nftables.service

[Service]
# This template unit is started by the control plane via systemd-run, one
# instance per VM: `systemctl start firecracker-jailer@<session-id>.service`.
# The control plane typically launches jailer directly (cheaper fork, no
# systemd roundtrip), but this unit exists so ops can:
#   1. `systemctl stop firecracker-jailer@<id>` to kill a specific learner VM.
#   2. `journalctl -u firecracker-jailer@<id>` to get just that VM's serial.
#
# Environment variables come from /etc/learn-platform/session-%i.env, which
# the control plane writes immediately before `systemctl start`.

Type=simple
EnvironmentFile=/etc/learn-platform/session-%i.env
ExecStart=/usr/local/libexec/learn-platform/jailer.sh \
  --vm-id %i \
  --uid ${LEARN_UID} \
  --gid ${LEARN_GID} \
  --chroot-base /srv/jailer \
  --cpu-quota-us 100000 \
  --mem-bytes 1073741824 \
  --kernel ${KERNEL_PATH} \
  --rootfs ${ROOTFS_PATH} \
  --vm-dir ${VM_DIR} \
  --firecracker-bin /usr/local/bin/firecracker \
  --seccomp-profile /etc/learn-platform/jailer/learn-seccomp.json \
  --vsock-uds ${VSOCK_UDS} \
  --vsock-cid ${VSOCK_CID} \
  --tap ${TAP} \
  --guest-mac ${GUEST_MAC} \
  --boot-args "${BOOT_ARGS}" \
  --vcpu 1 --mem-mib 1024

# Keep jailer-owned chroot across restarts? No. The control plane re-provisions
# rootfs per session. On stop, jailer's chroot stays on disk and is GC'd by a
# timer; we do not delete here to keep forensics intact when a VM crashes.
KillMode=mixed
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jailer /var/lib/firecracker /etc/learn-platform
# jailer and firecracker need /dev/kvm, /dev/net/tun, and the vsock device.
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
DeviceAllow=/dev/vhost-vsock rw
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateTmp=yes

[Install]
# Template units are not enabled directly; the control plane starts instances.
WantedBy=multi-user.target
