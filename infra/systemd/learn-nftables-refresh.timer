[Unit]
Description=Nightly refresh of learn-platform nftables sets
Requires=learn-nftables-refresh.service

[Timer]
OnCalendar=*-*-* 03:17:00
# Spread the load across the fleet; drift so everyone does not hit the DNS
# resolver at the same minute.
RandomizedDelaySec=600
Persistent=true
Unit=learn-nftables-refresh.service

[Install]
WantedBy=timers.target
