# terminal.example.com -> control plane on 127.0.0.1:8080
# Caddy auto-obtains TLS via ACME HTTP-01 (port 80 is open in ufw).

{
	email ops@example.com
}

terminal.example.com {
	encode zstd gzip

	# Everything goes to the control plane: pages, sessions API and the PTY
	# WebSocket. Timeouts are off because a terminal stream lives for hours.
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	log {
		output file /var/log/caddy/terminal.example.com.access.log {
			roll_size 10mb
			roll_keep 10
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
