# Control plane base URL the server uses to fetch public profile/certificate data.
# Prod: https://api.learn.example.com
CONTROL_PLANE_URL=https://api.learn.example.com

# Same URL exposed to the client (StatusLive polls /healthz).
NEXT_PUBLIC_CONTROL_PLANE_URL=https://api.learn.example.com

# Public site base, used for canonical URLs and OG absolute paths.
NEXT_PUBLIC_SITE_URL=https://learn.example.com

# Public Ed25519 key (hex, 32 bytes) used by /verify/[id] to check certificate
# signatures client-side. Minted by Agent-API; keep the private half off-web.
NEXT_PUBLIC_CERT_VERIFY_PUBKEY=

# PostHog (optional). Leave empty in dev to skip the snippet.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
