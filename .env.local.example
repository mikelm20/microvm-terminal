# Copy to .env.local and edit as needed. .env.local is gitignored.
# Loaded by docker compose and the Makefile.

# Local Postgres (matches infra/docker-compose.dev.yml defaults).
PG_DB=microvm
PG_USER=microvm
PG_PASSWORD=microvm
PG_PORT=5432

# Convenience URL for the control plane and psql.
DATABASE_URL=postgres://microvm:microvm@localhost:5432/microvm?sslmode=disable
