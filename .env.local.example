# Copy to .env.local and edit as needed. .env.local is gitignored.
# Loaded by docker compose and the Makefile.

# Local Postgres (matches infra/docker-compose.dev.yml defaults).
LEARN_PG_DB=learn
LEARN_PG_USER=learn
LEARN_PG_PASSWORD=learn
LEARN_PG_PORT=5432

# Convenience URL for the control plane and psql.
LEARN_DATABASE_URL=postgres://learn:learn@localhost:5432/learn?sslmode=disable

# pgAdmin (only if you enable the commented service).
LEARN_PGADMIN_EMAIL=dev@learn.local
LEARN_PGADMIN_PASSWORD=learn
