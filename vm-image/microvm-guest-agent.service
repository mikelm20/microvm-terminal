[Unit]
Description=microvm-terminal guest agent (vsock readiness + terminal resize)
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/microvm-guest-agent
Restart=on-failure
RestartSec=2s
# Root so it can open /dev/ttyS0 for TIOCSWINSZ.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
