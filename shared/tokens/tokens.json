{
  "$schema": "./tokens.schema.json",
  "version": "1.0.0",
  "color": {
    "surface": {
      "substrate": "#6e2608",
      "raised":    "#8f2f10",
      "sunken":    "#5b1e06",
      "divider":   "rgba(255, 246, 230, 0.12)"
    },
    "ink": {
      "primary":   "#fff6e6",
      "secondary": "#e6cba3",
      "tertiary":  "#a89070",
      "quiet":     "#6b5a44"
    },
    "flame": {
      "primary": "#ff9b5a",
      "edge":    "#e6724a",
      "glow":    "#ffc591"
    },
    "signal": {
      "success":   "#6fcf7a",
      "attention": "#ff9b5a"
    },
    "chromatic": {
      "burgundyTop":    "#a8391d",
      "burgundyMid":    "#8f2f10",
      "burgundyBottom": "#6e2608",
      "warm":           "#e6cba3",
      "warmHi":         "#fff6e6",
      "ember":          "#ffc591",
      "orange":         "#ff9b5a",
      "rust":           "#e6724a",
      "deep":           "#4a1a06"
    }
  },
  "type": {
    "family": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "JetBrains Mono, SF Mono, Menlo, monospace"
    },
    "role": {
      "display": { "size": "2.25rem",  "lineHeight": "1.04", "tracking": "-0.02em", "weight": 400 },
      "title":   { "size": "1.5rem",   "lineHeight": "1.15", "tracking": "-0.015em", "weight": 400 },
      "body":    { "size": "1rem",     "lineHeight": "1.55", "tracking": "0",        "weight": 400 },
      "meta":    { "size": "0.8125rem","lineHeight": "1.4",  "tracking": "0",        "weight": 400 },
      "caps":    { "size": "0.6875rem","lineHeight": "1.3",  "tracking": "0.18em",   "weight": 400, "case": "upper" },
      "mono":    { "size": "0.875rem", "lineHeight": "1.5",  "tracking": "0",        "weight": 400, "family": "mono" }
    }
  },
  "space": {
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "6":  "24px",
    "8":  "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "chip":  "16px",
    "card":  "24px",
    "pill":  "9999px"
  },
  "motion": {
    "curve": {
      "enter":   "cubic-bezier(0.20, 0.80, 0.30, 1.00)",
      "exit":    "cubic-bezier(0.40, 0.00, 1.00, 1.00)",
      "ambient": "cubic-bezier(0.40, 0.00, 0.60, 1.00)"
    },
    "duration": {
      "snap":   "120ms",
      "base":   "240ms",
      "settle": "480ms",
      "moment": "1400ms"
    }
  },
  "shadow": {
    "lift": "0 12px 36px rgba(0, 0, 0, 0.28)",
    "glow": "0 0 0 6px rgba(255, 197, 145, 0.20), 0 14px 36px rgba(230, 114, 74, 0.45)"
  },
  "haptics": {
    "tap":       { "style": "light",    "duration_ms": 12 },
    "confirm":   { "style": "success",  "duration_ms": 25, "pattern": "double" },
    "milestone": { "style": "heavy",    "duration_ms": 60 }
  }
}
